{
  "name": "advisor-harness",
  "version": "1.0.2",
  "description": "Harness de agentes + memoria persistente para opencode — reusable scaffold con agentes orquestados y memoria de 3 capas (Consigliere 1.0 (Advisor Harness), solo por proyecto)",
  "type": "module",
  "bin": {
    "advisor": "init.mjs",
    "advisor-harness": "init.mjs",
    "consigliere-harness": "init.mjs"
  },
  "files": [
    "init.sh",
    "init.ps1",
    "init.cmd",
    "init.mjs",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "keywords": [
    "opencode",
    "agents",
    "harness",
    "scaffold",
    "ai",
    "memory"
  ],
  "author": "fcocampione-star",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fcocampione-star/consigliere.git"
  },
  "bugs": {
    "url": "https://github.com/fcocampione-star/consigliere/issues"
  },
  "homepage": "https://github.com/fcocampione-star/consigliere",
  "scripts": {
    "test": "node --check init.mjs && node test/run.mjs && node .opencode/scripts/memory-rotate.test.mjs && node .opencode/scripts/contract-tests.mjs && node .opencode/scripts/version-check.mjs && echo \"harness ok\"",
    "test:unit": "node test/run.mjs",
    "test:contract": "node .opencode/scripts/contract-tests.mjs",
    "dev:config": "node .opencode/scripts/dev-config.mjs",
    "lint:sh": "node .opencode/scripts/lint-sh.mjs",
    "lint:ps1": "pwsh -NoProfile -Command \"$e=$null; [void][System.Management.Automation.Language.Parser]::ParseFile('init.ps1',[ref]$null,[ref]$e); if($e.Count){$e|%{Write-Error $_}; exit 1}\"",
    "version:check": "node .opencode/scripts/version-check.mjs",
    "version:bump": "node .opencode/scripts/version-bump.mjs",
    "prepublishOnly": "node .opencode/scripts/version-check.mjs && node .opencode/scripts/contract-tests.mjs"
  }
}
