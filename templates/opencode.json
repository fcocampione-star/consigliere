{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "advisor",
  "instructions": ["AGENTS.md"],
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ],
  "experimental": {
    "subagent_depth": 2,
    "todo": true
  },
  "agent": {
    "advisor": { "mode": "primary", "model": "{{MODEL_ADVISOR}}" },
    "planner": { "mode": "subagent", "model": "{{MODEL_PLANNER}}" },
    "builder": { "mode": "subagent", "model": "{{MODEL_BUILDER}}" },
    "verifier": { "mode": "subagent", "model": "{{MODEL_VERIFIER}}" },
    "critic": { "mode": "subagent", "model": "{{MODEL_CRITIC}}" },
    "summarizer": { "mode": "subagent", "model": "{{MODEL_SUMMARIZER}}" },
    "explore": { "mode": "subagent", "model": "{{MODEL_EXPLORE}}" }
  }
}
