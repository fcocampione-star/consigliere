{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "subagent_depth": 2,
  "instructions": ["AGENTS.md"],
  "agent": {
    "orchestrator": {
      "mode": "primary",
      "model": "{{MODEL_ORCHESTRATOR}}"
    },
    "planner": {
      "mode": "subagent",
      "model": "{{MODEL_PLANNER}}"
    },
    "builder": {
      "mode": "subagent",
      "model": "{{MODEL_BUILDER}}",
      "permission": {
        "bash": {
          "*": "allow",
          "rm -rf /*": "deny",
          "rm -rf ~*": "deny",
          "sudo rm*": "deny",
          "sudo dd*": "deny",
          "dd if=* of=/dev/*": "deny",
          "mkfs*": "deny",
          "chmod -R 777 /*": "deny",
          "chmod 777*": "deny",
          "del /f /s C:\\*": "deny",
          "rmdir /s* C:\\*": "deny",
          "Remove-Item* C:\\*": "deny",
          "Format-Volume*": "deny",
          "diskpart*": "deny",
          "git push*": "ask"
        }
      }
    },
    "verifier": {
      "mode": "subagent",
      "model": "{{MODEL_VERIFIER}}"
    },
    "critic": {
      "mode": "subagent",
      "model": "{{MODEL_CRITIC}}"
    },
    "summarizer": {
      "mode": "subagent",
      "model": "{{MODEL_SUMMARIZER}}"
    },
    "explore": {
      "mode": "subagent",
      "model": "{{MODEL_EXPLORE}}"
    }
  }
}
